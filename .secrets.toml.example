# `ricky init` does not create a secret file. Use `ricky setup` for the initial
# shared provider credential, or copy only the entries you need to the profile
# that owns them, for example
# `<user_data_dir>/profiles/personal/.secrets.toml`, and fill in real values.
#
#   mkdir -p ~/.ricky/profiles/personal
#   cp .secrets.toml.example ~/.ricky/profiles/personal/.secrets.toml
#
# The live .secrets.toml is never committed. Do not put secrets in
# ricky.toml. Use the shared profile only for credentials intentionally
# available to every runtime.

# OpenRouter API key — https://openrouter.ai/keys
openrouter_api_key = "sk-or-..."

# Anthropic API key — https://console.anthropic.com/settings/keys
anthropic_api_key = "sk-ant-..."

# Brave Search API key — https://api-dashboard.search.brave.com/
# Requires access to the Search product.
brave_search_api_key = "..."

# Slack user OAuth token (acts as you) — api.slack.com/apps → your app →
# OAuth & Permissions → "User OAuth Token". Required user-token scopes are
# listed in .designs/assets/slack-app-manifest.yaml.
slack_user_token = "xoxp-..."

# Telegram bot accounts use local names inside the owning profile. Installation-wide
# transports refer to them as profile/name (for example, personal/bot).
#
[messaging.telegram_accounts.bot]
bot_token = "123456789:replace-with-BotFather-token"
#
# Google Desktop OAuth clients. Keep these tables commented in the template;
# add them to the same profile's .secrets.toml with the real values. Local
# account names must match [google.accounts.*] in that profile's ricky.toml.
#
# [google_oauth_clients.home]
# client_id = "....apps.googleusercontent.com"
# client_secret = "..."
