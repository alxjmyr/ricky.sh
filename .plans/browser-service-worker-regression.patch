+async def test_real_chrome_persisted_worker_cannot_execute_forbidden_navigation(
+    installed_browser: _InstalledBrowser, tmp_path: Path
+) -> None:
+    """A post-navigation URL rejection is too late if a cached document executed."""
+    with (
+        _fixture_server() as (blocked_origin, _),
+        _fixture_server(redirect_target=f"{blocked_origin}/worker-forbidden") as (
+            allowed_origin,
+            _,
+        ),
+    ):
+        profile = tmp_path / "profile"
+        # Ordinary setup can leave active workers in a persistent profile. Seed
+        # both origins before Ricky owns the context and applies its policy.
+        async with async_playwright() as playwright:
+            context = await playwright.chromium.launch_persistent_context(
+                str(profile),
+                executable_path=str(installed_browser.executable),
+                headless=True,
+                chromium_sandbox=True,
+                service_workers="allow",
+            )
+            try:
+                page = context.pages[0]
+                for origin in (blocked_origin, allowed_origin):
+                    await page.goto(f"{origin}/worker-setup", wait_until="domcontentloaded")
+                    async with asyncio.timeout(10):
+                        await page.evaluate("""async () => {
+                          await navigator.serviceWorker.register('/cached-navigation-worker.js');
+                          await navigator.serviceWorker.ready;
+                          if (!navigator.serviceWorker.controller)
+                            await new Promise(resolve => navigator.serviceWorker.addEventListener(
+                              'controllerchange', resolve, {once: true}));
+                        }""")
+                assert len(context.service_workers) == 2
+            finally:
+                await context.close()
+
+        async def guard(url: str) -> None:
+            if url.startswith(f"{blocked_origin}/"):
+                raise BrowserError(
+                    BrowserFailure(code="destination_blocked", message="fixture origin blocked")
+                )
+
+        backend = PlaywrightBrowserBackend()
+        try:
+            session = await backend.open_session(
+                BrowserLaunchOptions(
+                    mode="owned_persistent",
+                    user_data_dir=profile,
+                    download_temp_dir=tmp_path / "downloads",
+                    executable_path=installed_browser.executable,
+                    headless=True,
+                    navigation_timeout_ms=5_000,
+                    operation_timeout_ms=5_000,
+                    max_redirects=10,
+                    page_discovery_limit=10,
+                ),
+                destination_guard=guard,
+            )
+            controlled = (await session.pages())[0]
+            await controlled.navigate(f"{allowed_origin}/worker-setup")
+            with pytest.raises(BrowserError) as rejected:
+                await controlled.navigate(f"{allowed_origin}/worker-redirect")
+            assert rejected.value.failure.code == "destination_blocked"
+            assert (await controlled.state()).title != "Forbidden worker page"
+        finally:
+            await backend.aclose()
+
